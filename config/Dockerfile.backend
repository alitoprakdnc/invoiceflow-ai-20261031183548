# syntax=docker/dockerfile:1.4

############################
# Builder Stage
############################
FROM golang:1.22-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    gcc \
    musl-dev \
    make

# Create a non‑root user for the build (optional, but keeps permissions consistent)
RUN addgroup -S app && adduser -S -G app app

WORKDIR /src

# Cache go.mod/go.sum
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY backend/ ./

# Build the binary
# CGO_ENABLED=0 for a fully static binary (compatible with distroless)
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w" -o /out/server ./cmd/server

############################
# Runtime Stage
############################
FROM alpine:3.20 AS runtime

# Add a non‑root user
RUN addgroup -S app && adduser -S -G app app

# Install runtime dependencies (ca‑certificates for HTTPS outbound calls)
RUN apk add --no-cache ca-certificates tzdata

# Create app directory and set permissions
WORKDIR /app
RUN chown app:app /app

# Copy the compiled binary and migrations from the builder
COPY --from=builder --chown=app:app /out/server ./server
COPY --from=builder --chown=app:app /src/migrations ./migrations

# Expose the HTTP port used by the Gin server
EXPOSE 8080

# Set environment variables for production
ENV GIN_MODE=release \
    TZ=UTC \
    PORT=8080

# Switch to non‑root user
USER app

# Default command
ENTRYPOINT ["./server"]